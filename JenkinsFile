pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                sh 'npm ci'
                sh 'npx playwright install --with-deps'
            }
        }

        stage('Test') {
            steps {
                sh 'npx playwright test'
            }
        }
    }
post {
        always {
            archiveArtifacts(
                artifacts: 'playwright-report/**/*, test-results/**/*',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'tests passed successfully.'
        }

        failure {
            echo 'tests failed. Check the test results.'
        }
    }
}